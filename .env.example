# Frontend Environment Variables
VITE_CONTRACT_ADDRESS_COMMIT_REVEAL=0x...
VITE_CONTRACT_ADDRESS_BEST_OF_THREE=0x...
VITE_CONTRACT_ADDRESS_WITH_USDC=0x...
VITE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b1566469c3d
VITE_RPC_URL=https://mainnet.base.org
VITE_CHAIN_ID=8453
VITE_API_BASE_URL=http://localhost:3001/api
VITE_SENTRY_DSN=

# Backend Environment Variables
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/neon_rps
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_super_secret_jwt_key_change_in_production
BETTER_AUTH_SECRET=your_auth_secret_key

# API Security
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Web3 & Contract
PRIVATE_KEY=0x...
NETWORK=base_mainnet
ETHERSCAN_API_KEY=

# Coinbase Onramp
COINBASE_ONRAMP_PROJECT_ID=
COINBASE_ONRAMP_SECRET_KEY=

# Analytics & Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email & Communications
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SENDGRID_API_KEY=

# AWS/Cloud Services (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=neon-rps-media

# Feature Flags
ENABLE_DAILY_CHALLENGES=true
ENABLE_TOURNAMENTS=true
ENABLE_REFERRAL_SYSTEM=true
MAINTENANCE_MODE=false
